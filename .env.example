# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# MySQL 8 Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medexa
DB_USERNAME=medexa_user
DB_PASSWORD=change_me_db_password
DB_USE_SSL=false

# CORS Configuration
CORS_ALLOWED_ORIGINS=http://localhost:5173

# OpenAPI / Swagger UI (keep false in production)
SWAGGER_ENABLED=true

# Security / JWT (used in Authentication phase)
JWT_SECRET=change_me_at_least_64_characters_long_secret_key_for_hs256_signing
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Google OAuth2 (used in Authentication phase)
GOOGLE_CLIENT_ID=your_google_oauth_client_id
GOOGLE_CLIENT_SECRET=your_google_oauth_client_secret

# Razorpay Payment Gateway (used in Payment phase)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
