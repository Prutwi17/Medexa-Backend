# Spring Profile (dev | prod)
SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080

# Frontend Base URL (for verification/reset links and CORS)
FRONTEND_BASE_URL=http://localhost:5173
CORS_ALLOWED_ORIGINS=http://localhost:5173

# MySQL 8 Configuration
DB_HOST=localhost
DB_PORT=3306
DB_NAME=medexa
DB_USERNAME=medexa_user
DB_PASSWORD=change_me_db_password
DB_USE_SSL=false

# OpenAPI / Swagger UI (keep false in production)
SWAGGER_ENABLED=true

# Security / JWT (JWT_SECRET must be at least 32 characters / 256 bits)
JWT_SECRET=change_me_at_least_64_characters_long_secret_key_for_hs256_signing
JWT_ACCESS_EXPIRATION_MS=900000
JWT_REFRESH_EXPIRATION_MS=604800000

# Auth Cookies & Verification
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAME_SITE=Lax
AUTH_REQUIRE_EMAIL_VERIFICATION=true

# Initial Admin Seed (no public admin registration; set strong password locally)
ADMIN_SEED_ENABLED=true
ADMIN_SEED_NAME=Om Prasad
ADMIN_SEED_EMAIL=omp27614@gmail.com
ADMIN_SEED_PASSWORD=change_me_strong_admin_password

# Google OAuth2 (Web Client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# SMTP Mail (set MAIL_ENABLED=true with valid SMTP credentials to send real emails)
MAIL_ENABLED=false
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=no-reply@medexa.in

# Razorpay Payment Gateway (used in Payment phase)
RAZORPAY_KEY_ID=your_razorpay_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
